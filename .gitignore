# Dependencies - must never be committed.
# Windows-installed shims in node_modules/.bin lose their executable bit in git,
# which makes Linux builders (Vercel/Netlify/CI) fail with exit code 126.
node_modules/

# Build output - regenerated by `npm run build` on every deploy.
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.vite/
.cache/
.eslintcache
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local preview servers / deploy metadata
.vercel
.netlify
